# Salin ke .env.local untuk pengembangan lokal. Di Vercel, isi lewat dashboard
# (Production + Preview). Semua variabel di sini publik (NEXT_PUBLIC_*), jangan isi rahasia.

# Opsional. URL kanonik situs untuk sitemap/metadata. Tanpa ini, Vercel memakai
# URL produksi otomatis, dan lokal memakai http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Komentar giscus (GitHub Discussions). Ambil nilainya di https://giscus.app.
# Kalau kosong, bagian komentar menampilkan pesan bahwa komentar belum aktif.
# Repo dalam format owner/nama, mis. zagoourai-hub/learning-laravel
NEXT_PUBLIC_GISCUS_REPO=
# ID repo dari giscus.app (diawali R_)
NEXT_PUBLIC_GISCUS_REPO_ID=
# Nama kategori Discussions, mis. Announcements atau General
NEXT_PUBLIC_GISCUS_CATEGORY=
# ID kategori dari giscus.app (diawali DIC_)
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
